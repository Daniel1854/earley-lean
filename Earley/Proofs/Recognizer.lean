variable {T N : Type} [BEq T] [LawfulBEq T] [BEq N] [LawfulBEq N] [LawfulBEq (EarleyItem T N)]

@[grind]
def setOfBins {n : Nat} (bins : EarleyBins T N n) : Set (EarleyItem T N) :=
  { x | ∃ k, ∃ (hk : k < n), x ∈ items bins[k] }

-- While `= k` might seem more direct, `≤ k` helps with the induction on the elements within the set
-- I need to be able to showcase that the original items also exist in that set, and they can have
-- lower endIdx
@[grind]
def setOfModelK (G : ContextFreeGrammar T) (w : List T) (k : Nat) : Set (EarleyItem T G.NT) :=
  { x | x ∈ EarleySet G (mapT w) ∧ x.endIdx ≤ k}

@[grind]
def earleyListSet (G : ContextFreeGrammarList T N) (w : List T) : Set (EarleyItem T N) :=
  earleyList G w |>.bins |> setOfBins

@[grind →]
lemma binIdx_of_endIdx (G : ContextFreeGrammarList T N) (w : List T)
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (x : EarleyItem T N) {k : Nat} (hk : k < w.length + 1)
    (hmem : x ∈ items bins[k]) : k = x.endIdx := by
  grind

lemma false_of_impossibleCompletedItem {G : ContextFreeGrammar T} [BEq G.NT] {x : EarleyItem T G.NT}
    {w : List (Symbol T G.NT)} (heps : isEpsilonFree G) (hsound : isSound G w x)
    (hs : x.startIdx = x.endIdx) (hcomp : x.isComplete) : False := by
  have : nonEmptyDerives G := nonEmptyDerives_of_isEpsilonFree heps
  grind

section Subsets

theorem updateBinAux_IsPrefix (xs : List (BinItem T N)) (y : BinItem T N) :
    List.IsPrefix (items xs) (items (updateBinAux xs y)) := by
  induction xs generalizing y with
  | nil => grind
  | cons x xs ih => grind

theorem updateBinAux_extensive (xs : List (BinItem T N)) (y : BinItem T N) :
    items xs ⊆ items (updateBinAux xs y) :=
  List.IsPrefix.subset (updateBinAux_IsPrefix xs y)

theorem updateBinAuxY_extensive (xs : List (BinItem T N)) (y : BinItem T N) :
    y.item ∈ items (updateBinAux xs y) := by
  induction xs generalizing y with
  | nil => grind
  | cons x xs ih => grind

theorem updateBin_IsPrefix (xs ys : List (BinItem T N)) :
    List.IsPrefix (items xs) (items (updateBin xs ys)) := by
  induction ys generalizing xs with
  | nil => grind
  | cons y ys ih => grind [updateBinAux_IsPrefix]

theorem updateBin_extensive (xs ys : List (BinItem T N)) : items xs ⊆ items (updateBin xs ys) :=
  List.IsPrefix.subset (updateBin_IsPrefix xs ys)

theorem updateBinY_extensive (xs ys : List (BinItem T N)) : items ys ⊆ items (updateBin xs ys) := by
  induction ys generalizing xs with
  | nil => grind
  | cons y ys ih => grind [updateBinAuxY_extensive, updateBin_extensive]

theorem updateBins_IsPrefix {w : List T} {bins : EarleyBins T N (w.length + 1)} (i k : Nat)
    (hi : i < w.length + 1) (hk : k < w.length + 1) (newBin : List (BinItem T N)) :
    List.IsPrefix (items bins[i]) (items (updateBins bins k newBin hk)[i]) := by
  grind [updateBin_IsPrefix]

lemma updateBins_extensive {w : List T} {bins : EarleyBins T N (w.length + 1)}
    (k i : Nat) (hk : k < w.length + 1) (hi : i < w.length + 1) (newBin : List (BinItem T N)) :
    items bins[i] ⊆ items (updateBins bins k newBin hk)[i] :=
  List.IsPrefix.subset (updateBins_IsPrefix i k hi hk newBin)

lemma updateBinsNewBin_extensive {w : List T} {bins : EarleyBins T N (w.length + 1)}
    (k : Nat) (hk : k < w.length + 1) (newBin : List (BinItem T N)) :
    items newBin ⊆ items (updateBins bins k newBin hk)[k] := by
  grind [updateBinY_extensive]

lemma setOfBinsUpdateBins_extensive {w : List T} {bins : EarleyBins T N (w.length + 1)}
    (k : Nat) (hk : k < w.length + 1) (newBin : List (BinItem T N)) :
    setOfBins bins ⊆ setOfBins (updateBins bins k newBin hk) := by
  grind [updateBins_IsPrefix]

theorem earleyBinList_IsPrefix {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j i : Nat) (hk : k < w.length + 1) (hi : i < w.length + 1) :
    List.IsPrefix (items bins[i]) (items (earleyBinList G w k bins hk j hbins).bins[i]) := by
  fun_induction earleyBinList G w k bins hk j hbins with
  | case1 bins hk j hbins hj => grind
  | case2 bins hk j hbins hj x bins' hbins' => grind [updateBins_IsPrefix]

lemma earleyBinList_extensive {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j i : Nat) (hk : k < w.length + 1) (hi : i < w.length + 1) :
    items bins[i] ⊆ items (earleyBinList G w k bins hk j hbins).bins[i] :=
  List.IsPrefix.subset (earleyBinList_IsPrefix hbins k j i hk hi)

lemma lengthNth_le_lengthEarleyBinList {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j i : Nat) (hk : k < w.length + 1) (hi : i < w.length + 1) :
    bins[i].length ≤ (earleyBinList G w k bins hk j hbins).bins[i].length := by
  fun_induction earleyBinList G w k bins hk j hbins with
  | case1 bins hk j hbins hj => grind
  | case2 bins hk j hbins hj x bins' hbins' => grind [lengthNth_le_lengthUpdateBinNth]

lemma lengthNth_le_lengthStepNth (Gₗ : ContextFreeGrammarList T N) {w : List T}
    {bins : EarleyBins T N (w.length + 1)} {i k : Nat} {hk : k < w.length + 1}
    {hi : i < bins[k].length} (hxS : bins[k][i].item.startIdx < w.length + 1) :
    bins[k].length ≤ (match bins[k][i].item.nextSymbol with
    | some s =>
      match s with
      | Symbol.nonterminal A => updateBins bins k (predictList Gₗ A k) hk
      | Symbol.terminal a =>
        if hk : k ≥ w.length then bins
        else updateBins bins (k + 1) (scanList w bins[k][i].item a k (by lia) i) (by lia)
    | none => updateBins bins k (completeList bins[k][i].item bins (by lia) i) hk)[k].length := by
  grind [lengthNth_le_lengthUpdateBinNth]

lemma updateBins_idem_of_lower_idx {w : List T} {bins : EarleyBins T N (w.length + 1)}
    (k i : Nat) (hk : k < w.length + 1) (hi : i < k) (newBin : List (BinItem T N)) :
    (updateBins bins k newBin hk)[i] = bins[i] := by
  grind

lemma earleyBinList_idem_of_lower_idx {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j n : Nat) (hk : k < w.length + 1) (hj : j < k) :
    (earleyBinList G w k bins hk n hbins).bins[j] = bins[j] := by
  fun_induction earleyBinList G w k bins hk n hbins with
  | case1 bins hk j hbins hj => grind
  | case2 bins hk j hbins hj x bins' hbins' => grind

-- TODO: very notably, hj' is derivable from hj, but if I supply the proof on the fly via grind,
--       the fun_induction isn't able to apply the cases correctly.
lemma updateBinAux_getElem_of_lower_idx (xs : List (BinItem T N)) (y : BinItem T N) (j : Nat)
    (hj : j < xs.length) (hj' : j < (updateBinAux xs y).length) :
    (updateBinAux xs y)[j].item = xs[j].item := by
  fun_induction updateBinAux xs y generalizing j with
  | case1 => grind
  | case2 => grind
  | case3 x xs y xItem xP yItem yP hxy hxyP hm hneq ih => grind
  | case4 => grind
  | case5 x xs y h hxy ih => grind

lemma updateBin_getElem_of_lower_idx (xs ys : List (BinItem T N)) (j : Nat) (hj : j < xs.length)
    (hj' : j < (updateBin xs ys).length) :
    ((updateBin xs ys)[j]'(by grind [length_le_lengthUpdateBin])).item = xs[j].item := by
  induction ys generalizing xs with
  | nil => grind
  | cons y ys ih =>
    simp only [updateBin]
    specialize ih (updateBinAux xs y) (by grind [length_le_lengthUpdateBinAux])
    grind [updateBinAux_getElem_of_lower_idx]

lemma updateBins_getElem_of_lower_idx {w : List T} {bins : EarleyBins T N (w.length + 1)}
    (k j : Nat) (hk : k < w.length + 1) (hj : j < bins[k].length) (newBin : List (BinItem T N)) :
    ((updateBins bins k newBin hk)[k][j]'(by grind [lengthNth_le_lengthUpdateBinNth])).item
    = bins[k][j].item := by
  grind [updateBin_getElem_of_lower_idx]

-- TODO: very notably, hlen is derivable from hj, but if I supply the proof on the fly via grind,
--       the fun_induction isn't able to apply the cases correctly.
lemma earleyBinList_getElem_of_lower_idx {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j i : Nat) (hk : k < w.length + 1) (hj : j < bins[k].length) (hij : j < i)
    (hlen : j < (earleyBinList G w k bins hk i hbins).bins[k].length) :
    (earleyBinList G w k bins hk i hbins).bins[k][j].item = bins[k][j].item := by
  fun_induction earleyBinList G w k bins hk i hbins with
  | case1 bins hk i hbins hi => simp
  | case2 bins hk i hbins hi x bins' hbins' =>
    rename_i ih
    specialize ih (by grind [lengthNth_le_lengthUpdateBinNth]) (by lia) hlen
    rw [ih]
    grind [updateBins_getElem_of_lower_idx]

theorem updateBinAux_of_mem (xs : List (BinItem T N)) (y : BinItem T N) (hmem : y.item ∈ items xs) :
    items (updateBinAux xs y) = items xs := by
  induction xs generalizing y with
  | nil => grind
  | cons head tail ih => grind

theorem updateBin_of_sub {xs : List (BinItem T N)} {ys : List (BinItem T N)}
    (hmem : items ys ⊆ items xs) : items (updateBin xs ys) = items xs := by
  induction ys generalizing xs with
  | nil => grind
  | cons head tail ih => grind [updateBinAux_of_mem]

theorem updateBins_of_sub {n k : Nat} {bins : EarleyBins T N n} {newBin : List (BinItem T N)}
    {hk : k < n} (hmem : items newBin ⊆ items bins[k]) :
    items (updateBins bins k newBin hk)[k] = items bins[k] := by
  grind [updateBin_of_sub]

theorem eqItems_of_completeList_of_eqItems {w : List T}
    {bins1 bins2 : EarleyBins T N (w.length + 1)}
    {y : EarleyItem T N} (hxS : y.startIdx < w.length + 1) (j : Nat)
    (heq : ∀ n, ∀ (hn : n < w.length + 1), items bins1[n] = items bins2[n]) :
    items (completeList y bins1 hxS j) = items (completeList y bins2 hxS j) := by
  grind [completeList_eq_completeListI, completeListI]

theorem eqItems_of_updateBinAux_of_eqEntry {xs : List (BinItem T N)} {y1 y2 : BinItem T N}
    (heqy : y1.item = y2.item) : items (updateBinAux xs y1) = items (updateBinAux xs y2) := by
  induction xs generalizing y1 y2 with
  | nil => grind
  | cons x xs ih => grind

theorem eqItems_of_updateBinAux_of_eqBin {xs1 xs2 : List (BinItem T N)} {y : BinItem T N}
    (heqx : items xs1 = items xs2) : items (updateBinAux xs1 y) = items (updateBinAux xs2 y) := by
  induction xs1 generalizing y xs2 with
  | nil => grind
  | cons x1 xs1 ih =>
    rcases xs2 with _ | ⟨x2,xs2⟩
    · simp [items] at heqx
    · grind

theorem eqItems_of_updateBin_of_eqBin {xs1 xs2 ys : List (BinItem T N)}
    (heqx : items xs1 = items xs2) : items (updateBin xs1 ys) = items (updateBin xs2 ys) := by
  induction ys generalizing xs1 xs2 with
  | nil => grind [List.map_eq_nil_iff]
  | cons y ys ih =>
    simp only [updateBin]
    have hup : items (updateBinAux xs1 y) = items (updateBinAux xs2 y) := by
      exact eqItems_of_updateBinAux_of_eqBin heqx
    specialize ih hup
    apply ih

theorem eqItems_of_updateBin_of_eqEntry (xs ys2 : List (BinItem T N)) {ys1 : List (BinItem T N)}
    (heqy : items ys1 = items ys2) :
    items (updateBin xs ys1) = items (updateBin xs ys2) := by
  induction ys1 generalizing ys2 xs with
  | nil => grind [List.map_eq_nil_iff]
  | cons y1 ys1 ih =>
    rcases ys2 with _ | ⟨y2,ys2⟩
    · simp [items] at heqy
    · simp only [updateBin]
      specialize ih (updateBinAux xs y1) ys2 (by grind)
      simp only [items, List.map_cons, List.cons.injEq] at heqy
      have hup : items (updateBinAux xs y1) = items (updateBinAux xs y2) := by
        exact eqItems_of_updateBinAux_of_eqEntry heqy.left
      rw [ih]
      grind [eqItems_of_updateBin_of_eqBin]

theorem eqItems_of_updateBins_of_eqItems {w : List T}
    {bins1 bins2 : EarleyBins T N (w.length + 1)} {k : Nat} {hk : k < w.length + 1}
    {newBin1 newBin2 : List (BinItem T N)}
    (heqB : ∀ n, ∀ (hn : n < w.length + 1), items bins1[n] = items bins2[n])
    (heqN : items newBin1 = items newBin2) :
    ∀ n, ∀ (hn : n < w.length + 1),
    items (updateBins bins1 k newBin1 hk)[n] = items (updateBins bins2 k newBin2 hk)[n] := by
  have : ∀ n, ∀ (hn : n < w.length + 1), items (updateBin bins1[n] newBin1) =
      items (updateBin bins2[n] newBin2) := by
    intro n hn
    specialize heqB n hn
    have : items (updateBin bins1[n] newBin1) = items (updateBin bins2[n] newBin1) := by
      exact eqItems_of_updateBin_of_eqBin heqB
    grind [eqItems_of_updateBin_of_eqEntry]
  grind

theorem eqItems_of_earleyBinList_of_eqItems {G : ContextFreeGrammarList T N} {w : List T}
    {bins1 bins2 : EarleyBins T N (w.length + 1)} (hbins1 : isWellFormedBins G w bins1)
    (hbins2 : isWellFormedBins G w bins2) (k j : Nat) (hk : k < w.length + 1)
    (heq : ∀ n, ∀ (hn : n < w.length + 1), items bins1[n] = items bins2[n]) :
    ∀ n, ∀ (hn : n < w.length + 1),
    items (earleyBinList G w k bins1 hk j hbins1).bins[n] =
    items (earleyBinList G w k bins2 hk j hbins2).bins[n] := by
  -- fun_induction only wants to recurse on bins1 or bins2 but I need them to stay connected.
  -- so I simply case split and recurse myself.
  intro n hn
  if hj : j ≥ bins1[k].length then
    rw [earleyBinList]
    symm
    rw [earleyBinList]
    have : j ≥ bins2[k].length := by grind [List.length_map]
    simp only [ge_iff_le, this, hj, ↓reduceDIte]
    grind
  else
    rw [earleyBinList]
    symm
    rw [earleyBinList]
    symm
    have hj2 : ¬ j ≥ bins2[k].length := by grind [List.length_map]
    have : bins1[k][j].item = bins2[k][j].item := by
      specialize heq k hk
      have : j < (bins1[k].map (fun x => x.item)).length := by grind [List.length_map]
      have := List.getElem_of_eq heq this
      grind
    match hnext : bins2[k][j].item.nextSymbol with
    | some s =>
      match s with
      | Symbol.nonterminal A =>
        simp only [ge_iff_le, hj2, ↓reduceDIte, hnext, hj, this]
        apply eqItems_of_earleyBinList_of_eqItems
        apply eqItems_of_updateBins_of_eqItems heq (by simp)
      | Symbol.terminal a =>
        simp only [ge_iff_le, hj2, ↓reduceDIte, hnext, hj, this]
        if h : w.length ≤ k then
          simp only [h]
          apply eqItems_of_earleyBinList_of_eqItems
          exact heq
        else
          simp only [h]
          apply eqItems_of_earleyBinList_of_eqItems
          apply eqItems_of_updateBins_of_eqItems heq (by simp)
    | none =>
      simp only [ge_iff_le, hj2, ↓reduceDIte, hnext, hj, this]
      apply eqItems_of_earleyBinList_of_eqItems
      have : items (completeList bins2[k][j].item bins1 (by grind) j) =
             items (completeList bins2[k][j].item bins2 (by grind) j) := by
        apply eqItems_of_completeList_of_eqItems
        exact heq
      apply eqItems_of_updateBins_of_eqItems heq this
termination_by { x | isWellFormed G.rules (mapT w) x }.ncard + 1 - j
decreasing_by
  all_goals
  exact decreasingAux hbins1 j k hk (by lia)

set_option maxHeartbeats 500000 in
 -- FIXME: this proof does way too much, but it's also a pain to parametrize.
 -- The repeated, expensive matching against bins' seems to be the most obvious culprit.
lemma earleyBinList_idem {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G)
    {bins : EarleyBins T G.NT (w.length + 1)} (hbins : isWellFormedBins Gₗ w bins)
    (k j i n : Nat) (hk : k < w.length + 1) (hi : i ≤ j) (hn : n < w.length + 1)
    (hSound : ∀ x ∈ bins[k], isSound G (mapT w) x.item) :
    items (earleyBinList Gₗ w k bins hk i hbins).bins[n] =
    items (earleyBinList Gₗ w k (earleyBinList Gₗ w k bins hk i hbins).bins hk j
    (earleyBinList Gₗ w k bins hk i hbins).inv).bins[n] := by
  fun_induction earleyBinList Gₗ w k bins hk i hbins generalizing j with
  | case1 bins hk j hbins hj =>
    rw [earleyBinList]
    have : bins[k].length ≤ j := by lia
    simp [this]
  | case2 bins hk i hbins hi x bins' hbins' =>
    rename_i ih
    -- TODO: so this entails that I have to prove isSound for every operation and updateBins.
    have hSound' : ∀ x ∈ bins'[k], isSound G (mapT w) x.item := by
      sorry
    by_cases hij' : i + 1 ≤ j
    · apply ih j hij' hSound'
    next =>
    have hij : i = j := by grind
    specialize ih (j+1) (by lia) hSound'
    rw [ih]
    clear ih hi hij'
    symm
    have : j < bins'[k].length := by grind [lengthNth_le_lengthUpdateBinNth]
    have : ¬ j ≥ (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k].length := by
      have : bins'[k].length ≤ (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k].length := by
        apply lengthNth_le_lengthEarleyBinList
      lia
    rw [earleyBinList]
    simp only [ge_iff_le, this, ↓reduceDIte]
    have heBL := (earleyBinList Gₗ w k bins' hk (i + 1) hbins').inv
    have hidemAux : (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k][j].item =
        bins'[k][j].item := by
      simp only [hij]
      have : j < (earleyBinList Gₗ w k bins' hk (j + 1) hbins').bins[k].length := by
        simp only [hij, ge_iff_le, not_le] at this
        lia
      apply earleyBinList_getElem_of_lower_idx hbins' k j (by grind) (by grind)
        (by grind [lengthNth_le_lengthEarleyBinList]) (i := j + 1)
    match hnext : x.item.nextSymbol with
    | none =>
      have hidem : (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k][j].item = x.item := by
        grind [updateBins_getElem_of_lower_idx]
      clear hidemAux
      simp only [hidem, hnext]
      have inv1 : isWellFormedBins Gₗ w (updateBins
          (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins k (completeList x.item
          (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins (by grind) j) hk) := by
        grind [wfBins_of_completeList]
      have inv2 := (earleyBinList Gₗ w k bins' hk (i + 1) hbins').inv
      apply eqItems_of_earleyBinList_of_eqItems inv1 inv2
      clear inv1 inv2
      intro n hn
      if hnk : n = k then
        have hsub : items (completeList x.item (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins
            (by grind) j) ⊆ items (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k] := by
          have : items (completeList x.item bins (by grind) j) = items (completeList x.item
              (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins (by grind) j) := by
            if x.item.startIdx = k then
              have := hSound x (by grind)
              have := false_of_impossibleCompletedItem heps this (by grind) (by grind)
              grind
           else
              have : x.item.startIdx < k := by grind
              have : bins[x.item.startIdx] =
                  (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[x.item.startIdx] := by
                grind [earleyBinList_idem_of_lower_idx]
              grind [completeList]
          have : items (completeList x.item (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins
              (by grind) j) ⊆ items bins'[k] := by
            grind [updateBinsNewBin_extensive]
          apply subset_trans this
          apply earleyBinList_extensive
        simp only [hnk]
        apply updateBins_of_sub hsub
      else
        grind [updateBins_idem_of_lower_idx]
    | some s =>
      match hS : s with
      | .terminal t =>
        if hw : w.length ≤ k then
          have hidem : (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k][j].item = x.item := by
            grind [updateBins_getElem_of_lower_idx]
          simp [hidem, hnext, hw]
        else
          have hidem : (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k][j].item = x.item := by
            grind [updateBins_getElem_of_lower_idx]
          clear hidemAux
          simp only [hidem, hnext, hw, ↓reduceDIte]
          have inv1 : isWellFormedBins Gₗ w (updateBins (earleyBinList Gₗ w k bins' hk (i + 1)
              hbins').bins (k+1) (scanList w x.item t k (by lia) j) (by lia)) := by
            grind [wfBins_of_scanList]
          have inv2 := (earleyBinList Gₗ w k bins' hk (i + 1) hbins').inv
          apply eqItems_of_earleyBinList_of_eqItems inv1 inv2
          clear inv1 inv2
          intro n hn
          if hnk : n = k+1 then
            have hsub : items (scanList w x.item t k (by lia) j) ⊆
                items (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k+1] := by
              have : items (scanList w x.item t k (by lia) j) ⊆ items bins'[k+1] := by
                grind [updateBinsNewBin_extensive]
              apply subset_trans this
              apply earleyBinList_extensive
            simp only [hnk]
            apply updateBins_of_sub hsub
          else
            grind [updateBins_idem_of_lower_idx]
      | .nonterminal nt =>
        have hidem : (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k][j].item = x.item := by
          grind [updateBins_getElem_of_lower_idx]
        clear hidemAux
        simp only [hidem, hnext]
        have inv1 : isWellFormedBins Gₗ w (updateBins
            (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins k (predictList Gₗ nt k) hk) := by
          grind [wfBins_of_predictList]
        have inv2 := (earleyBinList Gₗ w k bins' hk (i + 1) hbins').inv
        apply eqItems_of_earleyBinList_of_eqItems inv1 inv2
        clear inv1 inv2
        intro n hn
        if hnk : n = k then
          have hsub : items (predictList Gₗ nt k) ⊆
              items (earleyBinList Gₗ w k bins' hk (i + 1) hbins').bins[k] := by
            have : items (predictList Gₗ nt k) ⊆ items bins'[k] := by
              grind [updateBinsNewBin_extensive]
            apply subset_trans this
            apply earleyBinList_extensive
          simp only [hnk]
          apply updateBins_of_sub hsub
        else
          grind [updateBins_idem_of_lower_idx]

lemma setOfBinsEarleyBinList_extensive {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j : Nat) (hk : k < w.length + 1) :
    setOfBins bins ⊆ setOfBins (earleyBinList G w k bins hk j hbins).bins := by
  fun_induction earleyBinList G w k bins hk j hbins with
  | case1 bins hk j hbins hj => grind
  | case2 bins hk j hbins hj x bins' hbins' =>
    rename_i ih
    apply subset_trans _ ih
    clear ih
    simp only [ge_iff_le, bins']
    match hnext : x.item.nextSymbol with
    | none => apply setOfBinsUpdateBins_extensive k hk
    | some s =>
      match hS : s with
      | .terminal t =>
        if hw : w.length ≤ k then
          simp [hw]
        else
          simp only [hw, ↓reduceDIte]
          apply setOfBinsUpdateBins_extensive (k+1)
      | .nonterminal n => apply setOfBinsUpdateBins_extensive k hk

section Unused

-- I think I should never reason on that level about extensive ?
lemma earleyBinsList_extensiveAux (G : ContextFreeGrammarList T N) (w : List T) (k n : Nat)
    (hi : k ≤ n) (hk : n < w.length) {x : EarleyItem T N}
    (hmem : x ∈ items (earleyBinsList G w n (by lia)).bins[k]) :
    x ∈ items (earleyBinsList G w (n+1) (by lia)).bins[k] := by
  grind [earleyBinList_extensive]

lemma earleyBinsList_extensive (G : ContextFreeGrammarList T N) (w : List T) (k n m : Nat)
    (hk : k ≤ n) (hn : n ≤ m) (hm : m < w.length + 1) {x : EarleyItem T N}
    (hmem : x ∈ items (earleyBinsList G w n (by lia)).bins[k]) :
    x ∈ items (earleyBinsList G w m (by lia)).bins[k] := by
  induction m with
  | zero =>
    grind [earleyBinsList_extensiveAux]
  | succ m ih =>
    if h : n = m+1 then
      grind
    else
      specialize ih (by grind) (by lia) hmem
      apply earleyBinsList_extensiveAux G w k m (by lia) (by lia) ih

end Unused

lemma updateBinAux_sub {s : Set (EarleyItem T N)} (xs : List (BinItem T N)) (y : BinItem T N)
    (hx : {x | x ∈ items xs} ⊆ s) (hy : y.item ∈ s) :
    {z | z ∈ items (updateBinAux xs y) } ⊆ s := by
  induction xs generalizing y with
  | nil => grind
  | cons x xs ih => grind

lemma updateBin_sub {s : Set (EarleyItem T N)} (xs ys : List (BinItem T N))
    (hx : {x | x ∈ items xs} ⊆ s) (hy : {y | y ∈ items ys} ⊆ s) :
    {z | z ∈ items (updateBin xs ys) } ⊆ s := by
  induction ys generalizing xs with
  | nil => grind
  | cons y ys ih => grind [updateBinAux_sub]

lemma updateBins_sub {w : List T} {bins : EarleyBins T N (w.length + 1)}
    {s : Set (EarleyItem T N)} (hb : setOfBins bins ⊆ s)
    (newBin : List (BinItem T N)) (k : Nat) (hk : k < w.length + 1)
    (hn : {y | y ∈ items newBin} ⊆ s) : setOfBins (updateBins bins k newBin hk) ⊆ s := by
  intro z hmemz
  simp only [setOfBins, Order.lt_add_one_iff, Set.mem_setOf_eq] at hmemz
  rcases hmemz with ⟨i,hi,hmem⟩
  if heq : i = k then
    have hb : {x | x ∈ items bins[k]} ⊆ s := by
      intro x hmemx
      apply hb
      simp only [setOfBins, Order.lt_add_one_iff, Set.mem_setOf_eq]
      use k, by lia
      apply hmemx
    have := updateBin_sub bins[k] newBin hb hn
    have hmem : z ∈ {z | z ∈ items (updateBin bins[k] newBin)} := by grind
    apply Set.mem_of_mem_of_subset hmem this
  else
    grind

end Subsets

section Soundness

lemma initList_sub_Model {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) : { x | x ∈ items (initList Gₗ)} ⊆ EarleySet G (mapT w) := by
  intro x hmem
  simp only [items, initList, List.map_map, List.mem_map, List.mem_filter, beq_iff_eq,
    Function.comp_apply, Set.mem_setOf_eq] at hmem
  rcases hmem with ⟨r,hmemr,hx⟩
  have hmemx : r ∈ G.rules := by grind [Finset.mem_toList]
  have hstart : r.input = G.initial := by grind
  rw [← hx]
  apply EarleySet.init r hmemx hstart

lemma earleyBinListSet_sub_model {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (bins : EarleyBins T G.NT (w.length + 1))
    (hbins : isWellFormedBins Gₗ w bins) (hsub : setOfBins bins ⊆ EarleySet G (mapT w))
    (k j : Nat) (hk : k < w.length + 1) :
    setOfBins (earleyBinList Gₗ w k bins hk j hbins).bins ⊆ EarleySet G (mapT w) := by
  fun_induction earleyBinList Gₗ w k bins hk j hbins with
  | case1 bins hk j hbins hj => grind [earleyBinList]
  | case2 bins hk j hbins hj x bins' hbins' =>
    rename_i ih
    apply ih
    simp only [ge_iff_le, bins']
    clear ih hbins' bins'
    match hnext : x.item.nextSymbol with
    | none =>
      simp only
      apply updateBins_sub hsub
      rename' x => y
      -- x is the original item to be completed, y isComplete, z is the completed item
      intro z
      simp only [items, completeList, incItem, List.map_map, List.mem_map, Function.comp_apply,
        Prod.exists, exists_and_right, Set.mem_setOf_eq, map_of_mapT, forall_exists_index, and_imp]
      intro x xIdx hF hz
      have hcomp : y.item.isComplete = true := by
        clear hF hz hsub
        grind
      have := mem_of_memFilterWithIdx hF
      have hx : x.item = ⟨x.item.rule, x.item.position, x.item.startIdx, y.item.startIdx⟩ := by
        have : x.item.endIdx = y.item.startIdx := by grind
        rw [← this]
      have hmemx : x.item ∈ EarleySet G (List.map Symbol.terminal w) := by
        apply Set.mem_of_mem_of_subset (by grind) hsub
      have hE : y.item.endIdx = k := by grind
      have hy : y.item = ⟨y.item.rule, y.item.position, y.item.startIdx, k⟩ := by rw [← hE]
      have hmemy : y.item ∈ EarleySet G (List.map Symbol.terminal w) := by
        apply Set.mem_of_mem_of_subset (by grind) hsub
      have hnext : x.item.nextSymbol = some (Symbol.nonterminal y.item.rule.input) := by
        have := P_of_filterWithIdx (bins[y.item.startIdx]'(by grind)) (fun x : BinItem T G.NT =>
          x.item.nextSymbol == some (Symbol.nonterminal y.item.rule.input)) hF
        simp only [beq_iff_eq] at this
        apply this
      rw [← hz]
      rw [hE]
      apply EarleySet.complete hx hmemx hy hmemy hcomp hnext
    | some s =>
      match hS : s with
      | .terminal t =>
        if hw : w.length ≤ k then
          simp [hw, hsub]
        else
          simp only [hw, ↓reduceDIte]
          apply updateBins_sub hsub
          if ht : w[k] = t then
            simp only [items, scanList, ht, BEq.rfl, ↓reduceIte, incItem, List.map_cons,
              List.map_nil, List.mem_cons, List.not_mem_nil, or_false, Set.setOf_eq_eq_singleton,
              map_of_mapT, Set.singleton_subset_iff]
            apply EarleySet.scan (by simp) (by grind) (by grind) (by grind) hnext
          else
            simp [items, scanList, ht]
      | .nonterminal n =>
        simp only
        apply updateBins_sub hsub
        intro y
        simp only [items, predictList, List.map_map, List.mem_map, List.mem_filter, beq_iff_eq,
          Function.comp_apply, Set.mem_setOf_eq, map_of_mapT, forall_exists_index, and_imp]
        intro r hmemr hr hy
        have hx : x.item = ⟨x.item.rule, x.item.position, x.item.startIdx, k⟩ := by
          have : x.item.endIdx = k := by grind
          rw [← this]
        rw [← hy]
        rw [← hr] at hnext
        have : r ∈ G.rules := by grind [Finset.mem_toList]
        apply EarleySet.predict hx (by grind) this hnext

lemma earleyBinListZeroSet_sub_model {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (bins : EarleyBins T G.NT (w.length + 1))
    (hbins : isWellFormedBins Gₗ w bins) (k : Nat) (hk : k < w.length + 1)
    (hsub : setOfBins bins ⊆ EarleySet G (mapT w)) :
    setOfBins (earleyBinList Gₗ w k bins hk 0 hbins).bins ⊆ EarleySet G (mapT w) := by
  grind [earleyBinListSet_sub_model]

lemma earleyBinsListSet_sub_model {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (k : Nat) (hk : k < w.length + 1) :
    setOfBins (earleyBinsList Gₗ w k hk).bins ⊆ EarleySet G (mapT w) := by
  induction k with
  | zero =>
    simp only [earleyBinsList]
    intro x hmem
    let wfBins := initBins Gₗ w
    have : setOfBins wfBins.bins ⊆ EarleySet G (mapT w) := by
      simp only [setOfBins, Order.lt_add_one_iff, map_of_mapT, wfBins]
      intro x hmem
      rcases hmem with ⟨k,hk,hmem⟩
      grind [initList_sub_Model w h]
    apply earleyBinListZeroSet_sub_model w h wfBins.bins wfBins.inv 0 (by simp) this (by grind)
  | succ k ih =>
    intro x hmem
    let hbins := (earleyBinsList Gₗ w k (by lia)).inv
    apply earleyBinListZeroSet_sub_model w h (earleyBinsList Gₗ w k (by lia)).bins hbins (k+1)
    · intro y hmemy
      have := ih (by lia)
      apply Set.mem_of_mem_of_subset hmemy this
    · simp only [earleyBinsList] at hmem
      grind [setOfBinsEarleyBinList_extensive]
    · lia

lemma earleyListSet_sub_model {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) : earleyListSet Gₗ w ⊆ EarleySet G (mapT w) := by
  simp only [earleyListSet, earleyList]
  have := earleyBinsListSet_sub_model w h w.length (by lia)
  grind

/--
The soundness criteria for the list implementation:
Given a finished item for a word within the set, the grammar has to be able to generate that word.
-/
public theorem soundnessEarleyList {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (hex : recognizeList Gₗ w) : G.Generates (mapT w) := by
  simp only [recognizeList, decide_eq_true_eq] at hex
  rcases hex with ⟨x, ⟨hmem, hfin⟩⟩
  have := earleyListSet_sub_model w h
  apply soundnessEarley (x := x)
  · have : {x | x ∈ items (earleyList Gₗ w).bins[w.length]} ⊆
        {x | x ∈ items (Vector.toList (earleyList Gₗ w).bins).flatten} := by
      intro x hmem
      grind [Vector.mem_toList_iff]
    grind [Vector.mem_toList_iff, Set.setOf_subset_setOf]
  · grind

end Soundness

section Completeness

lemma initModel_sub_initL {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) {r : ContextFreeRule T G.NT} (hmemr : r ∈ G.rules)
    (hr : r.input = G.initial) : ⟨r,0,0,0⟩ ∈ items (initList Gₗ) := by
  simp only [items, initList, List.map_map, List.mem_map, List.mem_filter, beq_iff_eq,
    Function.comp_apply, EarleyItem.mk.injEq, and_self, and_true, exists_eq_right]
  grind [Finset.mem_toList]

lemma initModel_sub_earleyBinListZero {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {Gₗ : ContextFreeGrammarList T G.NT} (w : List T)
    (h : CFGEqCFGₗ G Gₗ) {r : ContextFreeRule T G.NT} (hmem : r ∈ G.rules)
    (hr : r.input = G.initial) : ⟨r,0,0,0⟩ ∈
    items (earleyBinList Gₗ w 0 (initBins Gₗ w).bins (by simp) 0 (by grind)).bins[0] := by
  have hsub := initModel_sub_initL h hmem hr
  let wfBins := initBins Gₗ w
  let wfBins' := earleyBinList Gₗ w 0 wfBins.bins (by simp) 0 wfBins.inv
  have : items wfBins.bins[0] ⊆ items wfBins'.bins[0] := by
    apply earleyBinList_extensive (hi := by simp)
  apply @Set.mem_of_mem_of_subset _ ⟨r,0,0,0⟩ _ _ hsub this

lemma scanMem_of_earleyBinListIndexAux {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j : Nat) (hk : k < w.length) (hj : ¬ (j ≥ bins[k].length))
    {x : EarleyItem T N} (hx : x = bins[k][j].item) (a : T)
    (hnext : bins[k][j].item.nextSymbol = some (Symbol.terminal a)) :
    items (scanList w x a k (by grind) j) ⊆
    items ((earleyBinList G w k bins (by lia) j hbins).bins[k+1]'(by grind)) := by
  intro y hmemy
  rw [earleyBinList]
  have : ¬ (w.length ≤ k) := by grind
  simp only [ge_iff_le, this, hj, ↓reduceDIte, hnext]
  have : y ∈ items (updateBins bins (k+1) (scanList w x a k (by lia) j) (by grind))[k+1] := by
    grind [updateBinsNewBin_extensive]
  have : isWellFormedBins G w
      (updateBins bins (k+1) (scanList w x a k (by lia) j) (by grind)) := by
    grind [wfBins_of_scanList]
  have : y ∈ items (earleyBinList G w k (updateBins bins (k+1) (scanList w x a k (by lia) j)
      (by lia)) (by lia) (j + 1) this).bins[k+1] := by grind [earleyBinList_extensive]
  grind

lemma scanMem_of_earleyBinListIndex {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) (k j : Nat) (hk : k < w.length)
    (hj : ¬ (j ≥ (earleyBinsList Gₗ w k (by lia)).bins[k].length))
    {x : EarleyItem T G.NT} (hx : x = (earleyBinsList Gₗ w k (by lia)).bins[k][j].item) (a : T)
    (hnext :
      (earleyBinsList Gₗ w k (by lia)).bins[k][j].item.nextSymbol = some (Symbol.terminal a)) :
    items (scanList w x a k (by grind) j) ⊆
    items ((earleyBinsList Gₗ w k (by lia)).bins[k+1]'(by grind)) := by
  intro y hmemy
  cases k with
  | zero =>
    have hbins := (initBins Gₗ w).inv
    have := earleyBinList_idem h heps hbins 0 j 0 1 (by lia) (by grind) (by lia) sorry
    have := (earleyBinList Gₗ w 0 (initBins Gₗ w).bins (by lia) 0 hbins).inv
    have : y ∈ items (earleyBinList Gₗ w 0 (earleyBinList Gₗ w 0
        (initBins Gₗ w).bins (by lia) 0 hbins).bins (by lia) j this).bins[1] := by
      exact scanMem_of_earleyBinListIndexAux _ 0 j (by lia) (by grind) hx a hnext hmemy
    grind
  | succ k =>
    have hbins := (earleyBinsList Gₗ w k (by lia)).inv
    have := earleyBinList_idem h heps hbins (k+1) j 0 (k + 2) (by lia) (by grind) (by lia) sorry
    have := (earleyBinList Gₗ w (k + 1) (earleyBinsList Gₗ w k (by lia)).bins (by lia) 0 hbins).inv
    have : y ∈ items (earleyBinList Gₗ w (k + 1)
        (earleyBinList Gₗ w (k + 1) (earleyBinsList Gₗ w k (by lia)).bins (by lia) 0 hbins).bins
        (by lia) j this).bins[k + 1 + 1] := by
      exact scanMem_of_earleyBinListIndexAux _ (k+1) j (by lia) (by grind) hx a hnext hmemy
    grind

lemma scanModel_sub_scanL {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {pos i : Nat} {r : ContextFreeRule T G.NT}
    {a : Symbol T G.NT} (k : Nat) (hk : k < w.length) {x : EarleyItem T G.NT}
    (hx : x = ⟨r, pos, i, k⟩) (hmem : x ∈ items (earleyBinsList Gₗ w k (by lia)).bins[k])
    (hnext : x.nextSymbol = some a) (hw : (mapT w)[k]'(by grind) = a) :
    ⟨r, pos+1, i, k+1⟩ ∈
    items ((earleyBinsList Gₗ w k (by lia)).bins[k+1]) := by
  -- TODO: Should've went with w : List T in the model as well. But for now, no need to change.
  have : ∃ a', a = Symbol.terminal a' := by grind
  rcases this with ⟨a, ha⟩
  -- Get the index of x to showcase that the call upon that item triggers scanX
  have := List.getElem_of_mem hmem
  rcases this with ⟨j, hjI, heq⟩
  -- x = bins[k][j]
  have hmemT : ⟨r, pos+1, i, k+1⟩ ∈ items (scanList w x a k (by lia) j) := by grind [scanList]
  have : items (scanList w x a k (by lia) j) ⊆
      items (earleyBinsList Gₗ w k (by lia)).bins[k + 1] := by
    have hj' : ¬ (j ≥ (earleyBinsList Gₗ w k (by lia)).bins[k].length) := by grind
    have heq' : x = (earleyBinsList Gₗ w k (by lia)).bins[k][j].item := by grind
    apply scanMem_of_earleyBinListIndex h heps k j hk hj' heq'
    grind
  apply Set.mem_of_mem_of_subset hmemT this (x := ⟨r, pos+1, i, k+1⟩)

lemma predictMem_of_earleyBinListIndexAux {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    (k j : Nat) (hk : k < w.length + 1) (hj : ¬ (j ≥ bins[k].length))
    (A : N) (hnext : bins[k][j].item.nextSymbol = some (Symbol.nonterminal A)) :
    items (predictList G A k) ⊆
    items ((earleyBinList G w k bins (by lia) j hbins).bins[k]'(by grind)) := by
  intro y hmemy
  rw [earleyBinList]
  simp only [ge_iff_le, hj, ↓reduceDIte, hnext]
  have : y ∈ items (updateBins bins k (predictList G A k) (by grind))[k] := by
    grind [updateBinsNewBin_extensive]
  have : isWellFormedBins G w (updateBins bins k (predictList G A k) (by grind)) := by
    grind [wfBins_of_predictList]
  have : y ∈ items (earleyBinList G w k (updateBins bins k (predictList G A k) (by lia))
    (by lia) (j + 1) this).bins[k] := by grind [earleyBinList_extensive]
  grind

lemma predictMem_of_earleyBinListIndex {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {bins : EarleyBins T G.NT (w.length + 1)}
    (hbins : isWellFormedBins Gₗ w bins) (k j : Nat) (hk : k < w.length + 1)
    (hj : ¬ (j ≥ (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k].length)) (A : G.NT)
    (hnext : (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k][j].item.nextSymbol
      = some (Symbol.nonterminal A)) :
    items (predictList Gₗ A k) ⊆
    items ((earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k]'(by grind)) := by
  intro y hmemy
  have := earleyBinList_idem h heps hbins k j 0 k hk (by grind) hk sorry
  rw [this]
  apply predictMem_of_earleyBinListIndexAux
  · exact hnext
  · exact hmemy
  · exact hj

lemma predictModel_sub_predictL {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {bins : EarleyBins T G.NT (w.length + 1)}
    (hbins : isWellFormedBins Gₗ w bins) {k : Nat} {r2 : ContextFreeRule T G.NT}
    {x : EarleyItem T G.NT} (hk : k < w.length + 1)
    (ih : x ∈ items (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k]) (hmemr2 : r2 ∈ Gₗ.rules)
    (hnext : x.nextSymbol = some (Symbol.nonterminal r2.input)) :
    ⟨r2, 0, k, k⟩ ∈ items ((earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k]'(by grind)) := by
  -- Get the index of x to showcase that the call upon that item triggers predictX
  have := List.getElem_of_mem ih
  rcases this with ⟨j, hjI, heq⟩
  -- x = (eBL k 0 bins)[k][j]
  have hmemT : ⟨r2, 0, k, k⟩ ∈ items (predictList Gₗ r2.input k) := by
    simp [hmemr2, items, predictList, List.map_map, List.mem_map, List.mem_filter, beq_iff_eq,
      Function.comp_apply, EarleyItem.mk.injEq, and_self, and_true, exists_eq_right]
  have : items (predictList Gₗ r2.input k) ⊆
      items (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k] := by
    have hj' : ¬ (j ≥ (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k].length) := by grind
    apply predictMem_of_earleyBinListIndex h heps hbins k j (by lia) hj' r2.input (by grind)
  apply Set.mem_of_mem_of_subset hmemT this (x := ⟨r2, 0, k, k⟩)

lemma completeMem_of_earleyBinListIndexAux {G : ContextFreeGrammarList T N} {w : List T}
    {bins : EarleyBins T N (w.length + 1)} (hbins : isWellFormedBins G w bins)
    {posy j k n : Nat} {r2 : ContextFreeRule T N} {y : EarleyItem T N}
    (hk : k < w.length + 1) (hj : j < w.length + 1) (hn : ¬ (n ≥ bins[k].length))
    (hy : y = ⟨r2, posy, j, k⟩) (hmemy : y = bins[k][n].item)
    (hcomp : y.isComplete = true) :
    items (completeList y bins (by grind) n) ⊆
    items ((earleyBinList G w k bins (by lia) n hbins).bins[k]'(by grind)) := by
  intro z hmemz
  rw [earleyBinList]
  have : bins[k][n].item.nextSymbol = none := by grind
  simp only [ge_iff_le, hn, ↓reduceDIte, this]
  have hyS : y.startIdx < w.length + 1 := by grind
  have : z ∈ items (updateBins bins k (completeList y bins hyS n) (by grind))[k] := by
    grind [updateBinsNewBin_extensive]
  have : isWellFormedBins G w (updateBins bins k
      (completeList y bins hyS n) (by grind)) := by
    grind [wfBins_of_completeList]
  have : z ∈ items (earleyBinList G w k (updateBins bins k
      (completeList y bins hyS n) (by lia)) (by lia) (n + 1) this).bins[k] := by
    grind [earleyBinList_extensive]
  grind

lemma completeMem_of_earleyBinListIndex {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {bins : EarleyBins T G.NT (w.length + 1)}
    (hbins : isWellFormedBins Gₗ w bins) {posy j k n : Nat} {r2 : ContextFreeRule T G.NT}
    {y : EarleyItem T G.NT} (hk : k < w.length + 1) (hj : j < w.length + 1)
    (hn : ¬ (n ≥ (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k].length))
    (hy : y = ⟨r2, posy, j, k⟩)
    (hmemyL : y = (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k][n].item)
    (hcomp : y.isComplete = true) :
    items (completeList y (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins (by grind) n) ⊆
    items ((earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k]'(by grind)) := by
  intro z hmemz
  have := earleyBinList_idem h heps hbins k n 0 k hk (by grind) hk sorry
  rw [this]
  have := (earleyBinList Gₗ w k bins hk 0 hbins).inv
  apply completeMem_of_earleyBinListIndexAux this hk hj hn hy hmemyL hcomp
  exact hmemz

lemma completeModel_sub_completeL {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] {w : List T} {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {bins : EarleyBins T G.NT (w.length + 1)}
    (hbins : isWellFormedBins Gₗ w bins) {posx posy i j k : Nat} {r1 r2 : ContextFreeRule T G.NT}
    {x y : EarleyItem T G.NT} (hk : k < w.length + 1) (hj : j < w.length + 1)
    (hx : x = ⟨r1, posx, i, j⟩) (hy : y = ⟨r2, posy, j, k⟩)
    (hmemxL : x ∈ items (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[j])
    (hmemyL : y ∈ items (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k])
    (hnext : x.nextSymbol = some (Symbol.nonterminal r2.input)) (hcomp : y.isComplete = true) :
    ⟨r1, posx+1, i, k⟩ ∈
    items ((earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k]'(by grind)) := by
  -- Get the index of y to showcase that the call upon that item triggers complete
  have := List.getElem_of_mem hmemyL
  rcases this with ⟨n, hn, heq⟩
  -- y = (eBL k 0 bins)[k][n]
  have hmemT : ⟨r1, posx+1, i, k⟩ ∈
      items (completeList y (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins (by lia) n) := by
    simp only [items, completeList, List.map_map, List.mem_map, Function.comp_apply, Prod.exists,
      exists_and_right]
    -- x = (eBL k 0 bins)[k][m]
    have := List.getElem_of_mem hmemxL
    rcases this with ⟨m, hm, heq'⟩
    have : m < (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[j].length := by grind
    use (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[j][m]
    refine ⟨?_, by grind⟩
    apply memFilterWithIdxAux_of_mem
    · grind
    · grind
  have : items (completeList y (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins (by lia) n) ⊆
      items (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k] := by
    have hn' : ¬ (n ≥ (earleyBinList Gₗ w k bins (by lia) 0 hbins).bins[k].length) := by grind
    apply completeMem_of_earleyBinListIndex h heps hbins hk (by lia) hn' hy (by grind) hcomp
  apply Set.mem_of_mem_of_subset hmemT this (x := ⟨r1, posx+1, i, k⟩)

lemma modelKZero_sub_earleyBinsListZeroSet {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) {x : EarleyItem T G.NT}
    (hmemx : x ∈ EarleySet G (mapT w)) (hke : x.endIdx = 0) :
    x ∈ items (earleyBinsList Gₗ w 0 (by lia)).bins[0] := by
  induction hmemx with
  | init r hmem hr => exact initModel_sub_earleyBinListZero w h hmem hr
  -- There cant be a valid item generated through .scan in the first bin.
  | scan hx hmem hbounds hw hnext ih => grind
  | predict hx hmemx hmemr2 hnext ih =>
    rename_i x r1 r2 pos i j
    specialize ih (by grind)
    simp only at hke
    rw [hke]
    rw [hke] at hx
    let wfBins := initBins Gₗ w
    apply predictModel_sub_predictL h heps wfBins.inv (by lia) ih
      (by grind [Finset.mem_toList]) hnext
  | complete hx hmemx hy hmemy hcomp hnext ihx ihy =>
    rename_i x y r1 r2 posx posy i j k
    -- There can't exist a valid item generated through .complete in the first bin:
    -- since the grammar is epsilon free, there has to be at least a terminal consumed for a rule to
    -- be completed.
    -- But given the "wrong" assumptions, the proof should be quite similar to the k+1 one.
    --let hbins := (earleyBinsList Gₗ w 0 (by lia)).inv
    --have := completeModel_sub_completeL hbins (by lia) (by grind) hx hy --_ _ hnext hcomp
    have : isSound G (mapT w) y := by grind [soundItemEarley]
    have := false_of_impossibleCompletedItem heps this (by grind)
    grind

lemma modelK_sub_earleyBinsListSet {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) (k : Nat) (hk : k < w.length)
    (hsub : setOfModelK G w k ⊆ setOfBins (earleyBinsList Gₗ w k (by lia)).bins)
    {x : EarleyItem T G.NT} (hmemx : x ∈ EarleySet G (mapT w)) (hke : x.endIdx ≤ k + 1) :
    ∃ j, ∃ (hj : j ≤ w.length), x ∈ items (earleyBinsList Gₗ w (k + 1) (by lia)).bins[j] := by
  induction hmemx with
  | init r hmem hr =>
    use 0, by lia
    simp only [setOfModelK, map_of_mapT, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf,
      and_imp] at hsub
    have : ⟨r,0,0,0⟩ ∈ EarleySet G (List.map Symbol.terminal w) := EarleySet.init r hmem hr
    grind [earleyBinList_extensive]
  -- We want to show ⟨r,pos+1,i,j+1⟩ ∈ bins[j+1] from x ∈ bins[j] w/ x=⟨r,pos,i,j⟩
  | scan hx hmem hbounds hw hnext ih =>
    rename_i x r pos i j a
    use j+1, (by lia)
    -- Scan item could be generated through the earleyBinList call
    if hjk : k = j then
      specialize ih (by grind)
      rcases ih with ⟨k', hk', ih⟩
      have : ⟨r, pos + 1, i, j + 1⟩ ∈ items (earleyBinsList Gₗ w j (by lia)).bins[j + 1] := by
        let inv := (earleyBinsList Gₗ w (k + 1) (by lia)).inv
        have : k' = j := by grind
        have : x ∈ items (earleyBinsList Gₗ w j (by lia)).bins[j] := by
          simp only [hjk, this] at ih
          grind [earleyBinList_idem_of_lower_idx]
        apply scanModel_sub_scanL h heps j (by lia) hx this hnext hw
      grind [earleyBinList_extensive]
    -- Scan item is already present
    else
      simp only [setOfModelK, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf] at hsub
      specialize hsub ⟨r, pos+1, i, j+1⟩ ⟨EarleySet.scan hx hmem _ hw hnext, by grind⟩
      grind [earleyBinList_extensive]
  -- We want to show ⟨r2,0,j,j⟩ ∈ bins[j] from x ∈ bins[j] w/ x=⟨r1,pos,i,j⟩
  | predict hx hmemx hmemr2 hnext ih =>
    rename_i x r1 r2 pos i j
    use j, by lia
    -- Predict item could be generated through the earleyBinList call
    if hjk : j = k + 1 then
      specialize ih (by grind)
      rcases ih with ⟨k', hk', ih⟩
      have : k' = j := by
        let inv := (earleyBinsList Gₗ w (k + 1) (by lia)).inv
        grind
      simp only [hjk]
      simp only [hjk, this] at ih
      let hbins := (earleyBinsList Gₗ w k (by lia)).inv
      apply predictModel_sub_predictL h heps hbins (by lia) ih (by grind [Finset.mem_toList]) hnext
    -- Predict item is already present
    else
      simp only [setOfModelK, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf] at hsub
      specialize hsub ⟨r2,0,j,j⟩ ⟨EarleySet.predict hx (by grind) hmemr2 hnext, by grind⟩
      grind [earleyBinList_extensive]
  -- We want to show z=⟨r1,posx+1,i,kz⟩ ∈ bins[kz] from
  -- - x ∈ bins[j]  w/ x=⟨r1,posx,i,j⟩
  -- - y ∈ bins[kz] w/ y=⟨r2,posy,j,kz⟩
  | complete hx hmemx hy hmemy hcomp hnext ihx ihy =>
    rename_i x y r1 r2 posx posy i j kz
    use kz, by lia
    -- Complete item could be generated through the earleyBinList call
    if hjk : kz = k + 1 then
      specialize ihx (by grind)
      specialize ihy (by grind)
      rcases ihx with ⟨kx, hkx, ihx⟩
      rcases ihy with ⟨ky, hky, ihy⟩
      have : kx = j := by
        let inv := (earleyBinsList Gₗ w (k + 1) (by lia)).inv
        grind
      simp only [this] at ihx
      have : ky = k + 1 := by
        let inv := (earleyBinsList Gₗ w (k + 1) (by lia)).inv
        grind
      simp only [this] at ihy
      simp only [hjk] at hy
      simp only [hjk]
      let hbins := (earleyBinsList Gₗ w k (by lia)).inv
      apply completeModel_sub_completeL h heps hbins (by lia) (by lia) hx hy ihx ihy hnext hcomp
    -- Complete item is already present
    else
      simp only [setOfModelK, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf] at hsub
      specialize hsub ⟨r1,posx+1,i,kz⟩ ⟨EarleySet.complete hx hmemx hy hmemy hcomp hnext, by grind⟩
      grind [earleyBinList_extensive]

lemma modelK_sub_earleyListSetK {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) (k : Nat) (hk : k < w.length + 1) :
    setOfModelK G w k ⊆ setOfBins (earleyBinsList Gₗ w k hk).bins := by
  induction k with
  | zero =>
    simp only [setOfModelK, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf, and_imp]
    intro x hmemx hke
    use 0, (by lia)
    apply modelKZero_sub_earleyBinsListZeroSet w h heps hmemx (by lia)
  | succ k ih =>
    simp only [setOfModelK, setOfBins, Order.lt_add_one_iff, Set.setOf_subset_setOf, and_imp]
    intro x hmem hk
    specialize ih (by grind)
    apply modelK_sub_earleyBinsListSet w h heps k (by lia) ih hmem hk

lemma model_sub_earleyListSet {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) : EarleySet G (mapT w) ⊆ earleyListSet Gₗ w := by
  intro x hmem
  simp only [earleyListSet, setOfBins, earleyList, Order.lt_add_one_iff, Set.mem_setOf_eq]
  have := modelK_sub_earleyListSetK w h heps
  simp only [Order.lt_add_one_iff, setOfModelK, map_of_mapT, setOfBins, Set.setOf_subset_setOf,
    and_imp] at this
  grind

lemma model_eq_earleyListSet {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) : EarleySet G (mapT w) = earleyListSet Gₗ w := by
  have h1 := model_sub_earleyListSet w h heps
  have h2 := earleyListSet_sub_model w h
  apply subset_antisymm h1 h2

public theorem completenessEarleyList {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G)
    (hgen : G.Generates (mapT w)) : recognizeList Gₗ w := by
  simp only [recognizeList, decide_eq_true_eq]
  have hw : isWord G (mapT w) := by simp [isWord]
  -- Select a relevant finished item from the Model Proof
  have hc := completenessEarley hw hgen
  rcases hc with ⟨x, hmemx, hfin⟩
  use x
  -- Use the fact that the set of items generated by the model are the same as the impl
  have heq := model_eq_earleyListSet w h heps
  rw [heq] at hmemx
  simp only [earleyListSet, setOfBins, Order.lt_add_one_iff, Set.mem_setOf_eq] at hmemx
  rcases hmemx with ⟨k, hk, hmemx⟩
  -- Well-formedness proves that that item has to reside within the final bin
  let hbins := (earleyList Gₗ w).inv
  grind

end Completeness

/--
The correctness criteria for the recognizer.
A word can be generated from the grammar iff the algorithm recognizes the word.
-/
public theorem correctnessEarleyList {G : ContextFreeGrammar T} [BEq G.NT] [LawfulBEq G.NT]
    [LawfulBEq (EarleyItem T G.NT)] (w : List T) {Gₗ : ContextFreeGrammarList T G.NT}
    (h : CFGEqCFGₗ G Gₗ) (heps : isEpsilonFree G) :
    G.Generates (mapT w) ↔ recognizeList Gₗ w := by
  grind [soundnessEarleyList, completenessEarleyList]

end Recognizer
